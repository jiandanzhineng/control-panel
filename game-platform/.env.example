# 服务
GAME_PLATFORM_ENV=production
GAME_PLATFORM_LISTEN_ADDR=:8787
GAME_PLATFORM_DATABASE_PATH=/var/lib/game-platform/game-platform.db
GAME_PLATFORM_STORAGE_DRIVER=oss
GAME_PLATFORM_PUBLIC_SITE_ORIGINS=https://game.undersilicon.cn
# mobile 账号服务为唯一身份源；不要复制 JWT_SECRET 到这里。
GAME_PLATFORM_IDENTITY_API_BASE_URL=https://api.undersilicon.cn
GAME_PLATFORM_IDENTITY_TIMEOUT_SECONDS=10

# 投稿与归档限制
GAME_PLATFORM_MAX_UPLOAD_BYTES=20971520
GAME_PLATFORM_MAX_UNPACKED_BYTES=83886080
GAME_PLATFORM_MAX_ARCHIVE_FILES=200
GAME_PLATFORM_UPLOAD_EXPIRY_MINUTES=15
GAME_PLATFORM_GIT_TIMEOUT_SECONDS=45
GAME_PLATFORM_SUBMISSION_PREFIX=submissions

# OSS_BUCKET 公开读取；OSS_SUBMISSION_BUCKET 必须是私有 bucket。
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=ezs-games
OSS_SUBMISSION_BUCKET=ezs-game-submissions
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me

# 仅在首次从旧 registry 迁移时启用。
GAME_PLATFORM_EXISTING_REGISTRY_URL=https://game.undersilicon.cn/registry.json
